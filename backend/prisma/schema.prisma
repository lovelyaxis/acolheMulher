// schema.prisma — AcolheMulher
// Gerado a partir das migrations existentes em prisma/migrations/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  PROFISSIONAL
  ADMINISTRADOR
}

enum TipoUnidade {
  DELEGACIA_MULHER
  CRAS_CREAS
  CASA_ACOLHIMENTO
  DEFENSORIA_PUBLICA
  HOSPITAL_REFERENCIA
}

enum StatusEncaminhamento {
  PENDENTE
  CONCLUIDO
}

model Usuario {
  id              String    @id @default(uuid()) @db.VarChar(36)
  nome            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(150)
  senhaHash       String    @db.VarChar(255)
  perfil          Perfil
  cargo           String?   @db.VarChar(100)
  unidadeId       String?   @db.VarChar(36)
  ativo           Boolean   @default(true)
  tentativasLogin Int       @default(0)
  bloqueadoAte    DateTime? @db.DateTime
  criadoEm        DateTime  @db.Timestamp
  atualizadoEm    DateTime  @updatedAt @db.Timestamp

  unidade         Unidade?     @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  encaminhamentos Encaminhamento[]

  @@index([email])
  @@index([perfil])
  @@index([unidadeId])
}

model Unidade {
  id                  String      @id @default(uuid()) @db.VarChar(36)
  nome                String      @db.VarChar(150)
  tipo                TipoUnidade
  endereco            String      @db.VarChar(200)
  bairro              String      @db.VarChar(100)
  cep                 String      @db.VarChar(9)
  telefone            String?     @db.VarChar(20)
  horario             String?     @db.VarChar(100)
  ativa               Boolean     @default(true)
  vagasTotal          Int?
  vagasDisponiveis    Int?
  nomeNormalizado     String      @db.VarChar(150)
  enderecoNormalizado String      @db.VarChar(200)
  criadoEm            DateTime    @db.Timestamp
  atualizadoEm        DateTime    @updatedAt @db.Timestamp

  usuarios          Usuario[]
  encaminhamentos   Encaminhamento[]

  @@index([tipo])
  @@index([ativa])
  @@index([nomeNormalizado, enderecoNormalizado])
}

model Encaminhamento {
  id             String            @id @default(uuid()) @db.VarChar(36)
  codigoCaso     String            @unique @db.VarChar(50)
  tipoAtendimento String           @db.VarChar(100)
  unidadeDestinoId String          @db.VarChar(36)
  observacoes    String?           @db.Text
  status         StatusEncaminhamento @default(PENDENTE)
  profissionalId String            @db.VarChar(36)
  criadoEm       DateTime          @db.Timestamp
  atualizadoEm   DateTime          @updatedAt @db.Timestamp

  profissional   Usuario           @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  unidadeDestino Unidade           @relation(fields: [unidadeDestinoId], references: [id], onDelete: Restrict)

  @@index([profissionalId])
  @@index([unidadeDestinoId])
  @@index([status])
  @@index([codigoCaso])
}

model OrientacaoAnonima {
  id        String   @id @default(uuid()) @db.VarChar(36)
  mensagem  String   @db.Text
  categoria String   @db.VarChar(100)
  criadoEm  DateTime @db.Timestamp

  @@index([criadoEm])
}
