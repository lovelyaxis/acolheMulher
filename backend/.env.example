# Exemplo de configuração do back-end AcolheMulher.
# Copie este arquivo para .env e preencha com seus dados reais.
# Nunca commite o arquivo .env com senhas, chaves ou credenciais reais.

# Conexão com o MySQL
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/acolhemulher"

# Porta do servidor Express
PORT=3000

# Segredo usado para assinar os tokens JWT.
# Use um valor longo, aleatório e diferente em cada ambiente.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do token JWT (exemplos: 8h, 30m, 7d)
JWT_EXPIRES_IN="8h"

# Origem permitida para o front-end nas requisições CORS.
CORS_ORIGIN="http://localhost:5173"
